# Copy to backend/.env; Spring Boot imports it when run from Chat/ or Chat/backend/.
# Use KEY=value without shell quotes or export prefixes.
DB_URL=jdbc:mysql://localhost:3306/chat?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=chat_app
DB_PASSWORD=replace_with_your_local_password
DB_POOL_SIZE=10
SERVER_PORT=8086
# Local HTTP only; use true for HTTPS deployments.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
# Comma-separated explicit origins; wildcard is rejected because cookies are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:3001
CORS_MAX_AGE_SECONDS=3600
# Local directory for uploaded payloads; metadata remains in MySQL.
FILE_STORAGE_ROOT=./uploads
FILE_MAX_SIZE=20MB
FILE_MAX_REQUEST_SIZE=21MB
FILE_ALLOWED_CONTENT_TYPES=image/*,audio/*,video/*,text/plain,application/pdf,application/zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
