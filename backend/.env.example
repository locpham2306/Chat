# Copy to backend/.env; Spring Boot imports it when run from Chat/ or Chat/backend/.
# Use KEY=value without shell quotes or export prefixes.
DB_URL=jdbc:mysql://localhost:3306/chat?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=chat_app
DB_PASSWORD=replace_with_your_local_password
DB_POOL_SIZE=10
SERVER_PORT=8086
# Local HTTP only; use true for HTTPS deployments.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
